# Workstream G.10: the read-only model download service (standard library only). Build context: backend/
#   docker build -t scam/model-download:demo -f backend/federated/Dockerfile.download backend
FROM python:3.12-slim
WORKDIR /app
COPY federated/registry.py federated/download_service.py federated/inbox.py ./
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
USER 65534
CMD ["python", "download_service.py"]
