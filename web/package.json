{
  "name": "scamguard-web",
  "private": true,
  "version": "1.0.0",
  "description": "ScamGuard web app: a replica of the iOS app in a browser (static files, no build step at runtime).",
  "type": "module",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "sync": "node tools/sync_assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node --test --test-concurrency=1 tests/e2e/run.mjs",
    "compare": "node tests/e2e/compare.mjs"
  },
  "devDependencies": {
    "htm": "3.1.1",
    "lucide-static": "0.460.0",
    "playwright-core": "1.49.1"
  }
}
