# Template HorizontalPodAutoscaler for ONE worker, matching
# worker-deployment.yaml.tmpl. Copy/substitute ${SIGNAL} and ${LANGUAGE}
# the same way (see that file's header comment).
#
# Requires the metrics-server addon to be installed in-cluster for CPU
# metrics to be available.
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${SIGNAL}-${LANGUAGE}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${SIGNAL}-${LANGUAGE}
  minReplicas: 2
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 50
