      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address of the ScamGuard server. Emulator: 10.0.2.2 is your laptop (docker compose: :8080). Kubernetes: run demo/expose on the laptop; it prints https://<laptop Wi-Fi IP>:8443/api/. First time only: install demo/tls/ca.crt on this device. Without HTTPS, what callers say is sent as plain text."
          }
        }
      }
    },
    "srv_info_ios": {
      "comment": "Source: tools/i18n/strings/*.json",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address of the ScamGuard server. Simulator: localhost is the Mac running docker compose (:8080 = gateway, :8088/api/ = edge). iPhone: use the Mac's Wi-Fi IP instead of 192.168.1.23 (on the Mac: ipconfig getifaddr en0). HTTPS (Kubernetes, demo/expose): install demo/tls/ca.crt on the iPhone as a profile (Settings → General → VPN & Device Management), then trust it in General → About → Certificate Trust Settings. Without HTTPS, what callers say is sent as plain text."
          }
        }
      }
    },
